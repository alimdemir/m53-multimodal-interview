DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECURE_COOKIES=0

# Redis is strongly recommended when more than one app process is used.
REDIS_URL=

# Browser WebRTC. Production requires your own TURN server.
ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]

# Whisper large-v3-turbo / faster-whisper
ASR_ENABLED=0
ASR_MODEL_PATH=models/faster-whisper-large-v3-turbo
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_BEAM_SIZE=1
ASR_WORKERS=1

# Public Hugging Face weights downloaded explicitly; inference stays offline.
# local: Apple Silicon MLX Qwen3-4B; rules: no LLM.
QUESTION_BACKEND=local
EMOTION_ENABLED=1
HF_DEVICE=auto
HF_CPU_THREADS=4
EMOTION_TEXT_MODEL_PATH=models/emotion-text
EMOTION_AUDIO_MODEL_PATH=models/emotion-audio
EMOTION_VIDEO_MODEL_PATH=models/emotion-video
QWEN_MLX_MODEL_PATH=models/qwen-mlx

# PostgreSQL production example
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
